# ===================================================================
# ملف متغيرات البيئة والمفاتيح لتطبيق Chat Live
# Environment Configuration & Secrets Template
# ===================================================================
# انسخ هذا الملف باسم .env وضع مفاتيحك الخاصة فيه:
# cp .env.example .env
# هذا الملف مستبعد تماماً من الرفع على GitHub عبر .gitignore لحماية الأمان والخصوصية.

# Google Web Client ID for Google Sign-In via Credential Manager
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Facebook App Credentials for Social Auth
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token_here

# Gemini API Key (إن أردت تفعيل الذكاء الاصطناعي مستقبلاً)
# GEMINI_API_KEY=your_gemini_api_key_here

