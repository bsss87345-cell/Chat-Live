<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠️ أمان وخصوصية: لا نُدرج أي بيانات من التطبيق في النسخ الاحتياطي السحابي.

  السبب: ملف local_store.json يحوي — الملف الشخصي · البريد الإلكتروني · المنشورات ·
  سجل المتابعة · المحذوفات · كلمات مرور الغرف — وكان يُرفع لسحابة Google،
  ويُستخرج أيضاً بأمر adb backup من أي جهاز يُوصَل بكيبل.

  ملاحظة: هذا الملف يُتجاهل على أندرويد 12+ (يُستبدل بـdata_extraction_rules.xml)،
  لكنه يبقى فعّالاً على الأجهزة الأقدم — فالملفان ضروريان معاً.
-->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
