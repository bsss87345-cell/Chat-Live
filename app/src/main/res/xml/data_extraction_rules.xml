<?xml version="1.0" encoding="utf-8"?>
<!--
  ⚠️ أمان وخصوصية (أندرويد 12+): نفس سياسة backup_rules.xml —
  لا نسخ سحابي ولا نقل بين الأجهزة لأي بيانات من التطبيق.

  البيانات المحلية تشمل أسراراً (كلمات مرور الغرف) وبيانات شخصية (البريد · المنشورات).
  عند ربط قاعدة البيانات: المزامنة تصير من السحابة نفسها، والنسخ الاحتياطي للنظام غير مطلوب.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
